<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Courses - Ruang Murid</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet"/>
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #28c59d;
      color: #0B3D2D;
    }

    .container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 40px;
      color: white;
      font-size: 36px;
    }

    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .course-card {
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(12px);
      border-radius: 16px;
      padding: 24px;
      color: white;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
    }

    .course-card:hover {
      transform: translateY(-6px);
    }

    .course-card h2 {
      font-size: 26px;
      margin-bottom: 12px;
    }

    .course-card p {
      font-size: 26px;
      line-height: 1.4;
      margin-bottom: 12px;
    }

    .course-category {
      font-size: 20px;
      font-weight: bold;
      color: #D2F55C;
      margin-bottom: 20px;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 28px;
      }
    }
    
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: white;
      padding: 1rem 4rem;
      border-bottom: 1px solid #ddd;
      border-radius: 40px;
      margin: 40px;
      max-width: 1500px;
    }
    .logo {
      display: flex;
      align-items: center;
      font-weight: bold;
      font-size: 30px;
      color: #0B3D2D;
    }
    
    nav a {
      margin: 0 10px;
      color: #0B3D2D;
      text-decoration: none;
      font-weight: 700;
      font-size: 24px;
    }
    nav a.active {
      color: #177255
    }
    .auth-buttons {
      display: flex;
      gap: 1rem;
      height: 70px;
    }
    .auth-buttons a {
      padding: 8px 50px;
      border-radius: 30px;
      font-weight: bold;
      border: none;
      cursor: pointer;
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .sign-in {
      background-color: white;
      border: 2px solid #D2F55C !important;
      color: #0B3D2D;
      padding: 8px 50px;
      border-radius: 30px;
      font-weight: bold;
      border: none;
      cursor: pointer;
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .sign-up {
      background-color: #D2F55C;
      color: #0B3D2D;
      
    }
  </style>
</head>
<body>
  <center>
    <header>
      <div class="logo">
        Ruang Murid
      </div>
      <nav>
        <a href="/" class="active">Home</a>
        <a href="/courses">Courses</a>
        <a href="/my-course">My Course</a>
      </nav>
      <div class="auth-buttons">
        <% if (!user) { %>
          <a class="sign-in" href="/login">Sign In</a>
          <a class="sign-up" href="/register">Sign Up</a>
        <% } else { %>
          <a class="sign-up" href="/profile">Profile</a>
          <a class="sign-in" href="/logout">Log Out</a>
        <% } %>
      </div>
    </header>
  </center>

  <div class="container">
    <h1>My Courses</h1>
    <div class="courses-grid">
      <% user.forEach(el => { %>
        <div class="course-card">
          <h2><%= el.Course.title %></h2>
          <p><%= el.Course.description %></p>
          <div class="course-category"><%= el.Course.Category.name %></div>
            <button class="sign-in">View</button>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>
