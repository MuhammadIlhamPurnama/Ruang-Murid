<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ruang Murid</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet"/>
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #28c59d;
      color: white;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: white;
      padding: 1rem 4rem;
      border-bottom: 1px solid #ddd;
      border-radius: 40px;
      margin: 20px;
      max-width: 1500px;
    }
    .logo {
      display: flex;
      align-items: center;
      font-weight: bold;
      font-size: 40px;
      color: #0B3D2D;
    }
    
    nav a {
      margin: 0 10px;
      color: #0B3D2D;
      text-decoration: none;
      font-weight: 700;
      font-size: 30px;
    }
    nav a.active {
      color: #177255
    }
    .auth-buttons {
      display: flex;
      gap: 1rem;
      height: 80px;
    }
    .auth-buttons button {
      padding: 8px 50px;
      border-radius: 30px;
      font-weight: bold;
      border: none;
      cursor: pointer;
      font-size: 24px;
    }
    .sign-in {
      background-color: white;
      border: 2px solid #D2F55C !important;
      color: #0B3D2D;
    }
    .sign-up {
      background-color: #D2F55C;
      color: #0B3D2D;
    }

    .hero {
      display: flex;
      justify-content: center;
      gap: 20px;
      align-items: center;
      padding: 4rem 2rem;
    }
    .hero-text {
      max-width: 50%;
    
    }
    .hero-text h1 {
      font-size: 60px;
      font-weight: 800;
      margin-bottom: 1rem;
    }
    .hero-text p {
      font-size: 30px;
      line-height: 1.5;
    }
    .hero-image img {
      max-width: 1000px;
      border-radius: 20px;
    }
  </style>
</head>
<body>
  <center>
    <header>
      <div class="logo">
        Ruang Murid
      </div>
      <nav>
        <a href="#" class="active">Home</a>
        <a href="#">About Us</a>
        <a href="#">Courses</a>

      </nav>
      <div class="auth-buttons">
        <button class="sign-in">Sign In</button>
        <button class="sign-up">Sign Up</button>
      </div>
    </header>
  </center>
  <section class="hero">
    <div class="hero-text">
      <h1>Upgrade your skills, elevate your life</h1>
      <p>Explore a wide range of professional and personal development courses. Gain the skills you need to succeed</p>
    </div>
    <div class="hero-image">
      <img src="https://storage.googleapis.com/lashodia-product-image/11365282.jpg" alt="Man with headphone" />
    </div>
  </section>

</body>
</html>
